---
import type { Note } from "../lib/api";
const { notes = [] as Note[] } = Astro.props;
---
<section class="panel" aria-labelledby="notes-list-title">
  <div class="panel-header">
    <span id="notes-list-title" class="panel-title">Your Notes</span>
    <div>
      <button class="btn btn-primary" id="create-note">New</button>
    </div>
  </div>
  <div class="note-list" id="note-list" role="list" aria-label="Notes list">
    {notes.length === 0 ? (
      <div class="empty">
        <p>No notes yet. Click “New” to create your first note.</p>
      </div>
    ) : (
      notes.map((n) => (
        <div class="note-row" role="listitem" data-id={n.id}>
          <div>
            <div class="note-title">{n.title || "Untitled"}</div>
            <div class="note-meta">Updated {new Date(n.updatedAt).toLocaleString()}</div>
          </div>
          <div class="row-actions">
            <button class="action edit" data-id={n.id} aria-label={`Edit ${n.title || "note"}`}>Edit</button>
            <button class="action delete" data-id={n.id} aria-label={`Delete ${n.title || "note"}`}>Delete</button>
          </div>
        </div>
      ))
    )}
  </div>
</section>

<style>
  .panel { background: var(--surface); border: 1px solid var(--border-color); border-radius: var(--radius); box-shadow: var(--shadow-md); overflow: hidden; }
  .panel-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-bottom: 1px solid var(--border-color); background: color-mix(in lab, var(--surface) 92%, transparent); }
  .panel-title { font-weight: 600; }
  .note-list { display: grid; }
  .note-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--border-color); }
  .note-row:hover { background: color-mix(in lab, var(--primary) 8%, var(--surface)); }
  .note-title { font-weight: 600; }
  .note-meta { color: var(--text-secondary); font-size: 12px; }
  .row-actions { display: inline-flex; gap: 6px; }
  .action { border: 1px solid var(--border-color); background: var(--surface); height: 28px; padding: 0 8px; border-radius: 8px; cursor: pointer; color: var(--text-secondary); }
  .action.delete { color: #EF4444; }
  .empty { padding: 16px; color: var(--text-secondary); }
  .btn { height: 32px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--surface); color: var(--text-color); box-shadow: var(--shadow-sm); cursor: pointer; }
  .btn.btn-primary { border: none; background: linear-gradient(135deg, color-mix(in lab, var(--primary) 90%, white), color-mix(in lab, var(--primary) 70%, black)); color: #fff; }
</style>

<script>
  import { emit } from "../lib/events";
  // Click handlers for create/edit/delete
  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;
    if (target.id === "create-note") {
      emit("notes:new");
    }
    if (target.classList.contains("edit")) {
      const id = target.getAttribute("data-id");
      if (id) emit("notes:select", id);
    }
    if (target.classList.contains("delete")) {
      const id = target.getAttribute("data-id");
      if (id) emit("notes:delete", id);
    }
  });
</script>
